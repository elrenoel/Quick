# ==============================================================================
# Quick (AI Flashcard & Quiz App) — Environment Variables Template
# ==============================================================================
# Petunjuk:
# 1. Untuk local development, salin file ini menjadi .env.local dan isi nilainya.
# 2. Untuk deployment di Vercel, tambahkan variabel-variabel di bawah ini ke
#    Dashboard Vercel: Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL via Neon / Supabase)
# ------------------------------------------------------------------------------
# Ambil connection string dari Neon Dashboard (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API
# ------------------------------------------------------------------------------
# Dapatkan API key gratis dari Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Model Gemini yang digunakan (Default: gemini-3.5-flash-lite)
# Pilihan lain: gemini-3.6-flash, gemini-3.5-flash
GEMINI_MODEL="gemini-3.5-flash-lite"

# ------------------------------------------------------------------------------
# 3. Better Auth Configuration
# ------------------------------------------------------------------------------
# Secret acak minimal 32 karakter untuk enkripsi session & JWT.
# Cara generate: jalankan `openssl rand -base64 32` di terminal
BETTER_AUTH_SECRET="your_random_32_character_secret_key_here"

# Base URL aplikasi:
# - Lokal: http://localhost:3000
# - Vercel: https://your-project-name.vercel.app (tanpa trailing slash)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 Credentials (Opsional, untuk Login dengan Google)
# ------------------------------------------------------------------------------
# Buat OAuth Client ID di Google Cloud Console (https://console.cloud.google.com)
#
# Authorized JavaScript origins:
# - Lokal: http://localhost:3000
# - Production: https://your-project-name.vercel.app
#
# Authorized redirect URIs:
# - Lokal: http://localhost:3000/api/auth/callback/google
# - Production: https://your-project-name.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
